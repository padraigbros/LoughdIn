{
  "name": "loughdin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/vendor.mjs && node scripts/serve.mjs",
    "build": "node scripts/vendor.mjs && node scripts/build.mjs",
    "check": "node --check src/app.js && node --check src/timer.js && node --check src/storage.js && node --check src/sync.js",
    "test": "node --test tests/*.test.js",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/node": "26.1.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "supabase": "2.117.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/local-notifications": "8.3.1",
    "@supabase/supabase-js": "2.116.0"
  }
}
